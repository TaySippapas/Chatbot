    {
      "id": 13,
      "type": "table",
      "title": "Evaluation runs",
      "description": "Every full run of eval/run_eval.py, newest first. A commit ending in -dirty had uncommitted changes.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "quillmark-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "quillmark-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT created_at AS \"run\", git_commit AS \"commit\", question_file AS \"questions\", answers_correct || '/' || questions AS \"answers\", routes_correct || '/' || questions AS \"routes\", answers_with_unverified_figures + answers_with_case_only_figures + answers_with_invalid_citations AS \"flagged\", median_seconds AS \"median s\" FROM eval_runs ORDER BY created_at DESC LIMIT 20"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true
          }
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "type": "table",
      "title": "Failing in the latest evaluation",
      "description": "Questions that failed in the most recent run of each question set.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "quillmark-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "quillmark-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT r.question_file AS \"set\", e.item_id AS \"question\", e.category, array_to_string(e.problems, '; ') AS \"problems\" FROM eval_results e JOIN eval_runs r ON r.id = e.run_id WHERE r.id IN (SELECT max(id) FROM eval_runs GROUP BY question_file) AND NOT (e.answer_ok AND e.route_ok) ORDER BY 1, 2"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "fieldConfig": {
        "defaults": {
