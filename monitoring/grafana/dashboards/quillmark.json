    {
      "id": 12,
      "type": "timeseries",
      "title": "Evaluation score",
      "description": "Share of answers correct in each full evaluation run, per question set.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "quillmark-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
