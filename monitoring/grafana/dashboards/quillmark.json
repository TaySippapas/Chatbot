            "uid": "quillmark-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT decided_by, count(*) AS questions FROM interactions WHERE $__timeFilter(created_at) AND source IN ($source) AND decided_by IS NOT NULL GROUP BY 1 ORDER BY 2 DESC"
