          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE (cardinality(unverified_figures) > 0 OR cardinality(case_only_figures) > 0 OR cardinality(invalid_citations) > 0)) / NULLIF(count(*), 0) FROM interactions WHERE $__timeFilter(created_at) AND source IN ($source) AND error IS NULL"
