    {
      "id": 7,
      "type": "timeseries",
      "title": "Response time",
      "description": "Median and 90th percentile per time bucket.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "quillmark-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "quillmark-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, $__interval), percentile_cont(0.5) WITHIN GROUP (ORDER BY seconds_first_token) AS \"first word, median\", percentile_cont(0.9) WITHIN GROUP (ORDER BY seconds_first_token) AS \"first word, 90th pct\", percentile_cont(0.5) WITHIN GROUP (ORDER BY (seconds_route + coalesce(seconds_data, 0) + coalesce(seconds_retrieval, 0) + seconds_answer)) AS \"total, median\", percentile_cont(0.9) WITHIN GROUP (ORDER BY (seconds_route + coalesce(seconds_data, 0) + coalesce(seconds_retrieval, 0) + seconds_answer)) AS \"total, 90th pct\" FROM interactions WHERE $__timeFilter(created_at) AND source IN ($source) AND error IS NULL GROUP BY 1 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "pointSize": 6,
            "showPoints": "always",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Sources used",
      "description": "The handbook is always used; the router adds past cases and/or the case database.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "quillmark-pg"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "quillmark-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, $__interval), CASE WHEN used_database AND used_cases THEN 'handbook + database + cases' WHEN used_database THEN 'handbook + database' WHEN used_cases THEN 'handbook + cases' ELSE 'handbook only' END AS metric, count(*) AS value FROM interactions WHERE $__timeFilter(created_at) AND source IN ($source) AND error IS NULL GROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 70,
            "pointSize": 6,
            "showPoints": "auto",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "piechart",
      "title": "Who decided the route",
      "description": "Rules decide clear questions in about a millisecond; the LLM fills a form for the rest (about 4-5 s).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "quillmark-pg"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 8
