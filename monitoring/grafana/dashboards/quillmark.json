          }
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Safeguard flags",
      "description": "Answers with a figure backed by nothing given, a figure only from other customers' cases, or a citation of a document not provided.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "quillmark-pg"
      },
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "quillmark-pg"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT $__timeGroupAlias(created_at, $__interval), count(*) FILTER (WHERE cardinality(unverified_figures) > 0) AS \"unbacked figure\", count(*) FILTER (WHERE cardinality(case_only_figures) > 0) AS \"other customer's figure\", count(*) FILTER (WHERE cardinality(invalid_citations) > 0) AS \"citation not provided\" FROM interactions WHERE $__timeFilter(created_at) AND source IN ($source) AND error IS NULL GROUP BY 1 ORDER BY 1"
