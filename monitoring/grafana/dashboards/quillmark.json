          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "time_series",
          "rawSql": "SELECT created_at AS time, question_file AS metric, round(100.0 * answers_correct / questions, 1) AS value FROM eval_runs WHERE $__timeFilter(created_at) ORDER BY 1"
